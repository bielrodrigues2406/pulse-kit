# pulse-kit MCP server. Every variable is optional: a tool whose service is missing says so.

# Google Drive (read-only use): the same OAuth client and refresh token as polar-drive-sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The Polar_Flow_Sync root folder (the one that holds the <YYYY> folders).
GOOGLE_DRIVE_FOLDER_ID=

# trigger_polar_sync: fine-grained token with "Actions: read and write" on polar-drive-sync only.
GITHUB_TOKEN=
POLAR_SYNC_REPOSITORY=bielrodrigues2406/polar-drive-sync
POLAR_SYNC_WORKFLOW=polar-flow-sync.yml
POLAR_SYNC_REF=main

# analyze_recording reads only .json/.fit files inside this folder when it is set.
PULSE_KIT_RECORDINGS_DIR=
# Decides which calendar day is "today" for training load.
PULSE_KIT_TIME_ZONE=America/Sao_Paulo
